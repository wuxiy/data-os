# Vite variables are embedded into the static portal at build time.
# The client is a public OIDC client; never put a client secret here.
VITE_DATAOS_API_BASE_URL=/api
VITE_DATAOS_OIDC_ISSUER_URI=https://id.example.invalid/realms/data-os
VITE_DATAOS_OIDC_CLIENT_ID=data-os-portal
# Register this exact URI as an allowed redirect URI in the IdP.
VITE_DATAOS_OIDC_REDIRECT_URI=https://data-os.example.invalid/
