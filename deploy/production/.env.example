# Copy this file to .env on the production host and replace every placeholder.
# Keep .env outside version control. Values are intentionally not secret-safe.

DATAOS_VERSION=0.1.0
DATAOS_CONTROL_PLANE_IMAGE=medical-platform/data-os-control-plane:0.1.0

# Existing PostgreSQL may be used instead of this Compose database; in that case
# set DATAOS_DB_URL/USERNAME/PASSWORD and remove the postgres service dependency.
DATAOS_DB_NAME=data_os
DATAOS_DB_USERNAME=data_os
DATAOS_DB_PASSWORD=replace-with-a-long-random-password
DATAOS_DB_POOL_SIZE=20
DATAOS_DB_URL=jdbc:postgresql://postgres:5432/data_os
# Used only by deploy/production/provision-named-tenant.sh. Set the actual
# reachable host/port when DATAOS_DB_URL points to an external PostgreSQL.
DATAOS_DB_HOST=postgres
DATAOS_DB_PORT=5432
DATAOS_DB_SSLMODE=disable
# Keep false for a new database. For an existing pre-Flyway data_os schema,
# follow the one-time baseline procedure in README.md, then set it back to false.
DATAOS_FLYWAY_BASELINE_ON_MIGRATE=false
DATAOS_FLYWAY_BASELINE_VERSION=0

DATAOS_RUNTIME_ENV=production
# The platform portal is behind the hospital HTTPS ingress/LB. Keep false
# until that controlled TLS termination is in place; production startup then
# fails closed instead of serving an accidentally plaintext endpoint.
DATAOS_EXTERNAL_HTTPS_TERMINATED=false
DATAOS_SEED_DEMO=false

# OIDC is the only production authentication source. Use the issuer URL of the
# Keycloak/IdP realm, not the discovery document URL.
DATAOS_AUTH_MODE=ENFORCED
DATAOS_OIDC_ISSUER_URI=https://id.example.invalid/realms/data-os
DATAOS_OIDC_AUDIENCE=data-os
DATAOS_OIDC_CLOCK_SKEW_SECONDS=60
# Named tenant/institution are mandatory in production. Do not use default.
DATAOS_DEFAULT_TENANT_ID=hospital_a
DATAOS_DEFAULT_INSTITUTION_ID=hospital_a_main
DATAOS_DEFAULT_SCOPE_ENABLED=false

# Generate with: openssl rand -base64 32
DATAOS_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# SSRF policy is fail-closed in production. Use a comma-separated allowlist of
# source hostnames/IPs; private-network access needs an explicit security review.
DATAOS_SOURCE_ALLOW_HTTP=false
DATAOS_SOURCE_ALLOW_PRIVATE_NETWORKS=false
DATAOS_SOURCE_ALLOW_TEST_PROTOCOLS=false
DATAOS_SOURCE_MAX_RESPONSE_BYTES=65536
DATAOS_SOURCE_ALLOWED_HOSTS=source.example.invalid

DATAOS_QUALITY_EXECUTOR=HTTP
# Use the local Compose Runtime; replace with an HTTPS院内 Runtime only when
# quality-runner is intentionally deployed outside this Compose project.
DATAOS_QUALITY_EXECUTOR_BASE_URL=http://quality-runner:8080
DATAOS_QUALITY_DEMO_ENABLED=false
DATAOS_QUALITY_OIDC_TOKEN_URI=https://id.example.invalid/realms/data-os/protocol/openid-connect/token
DATAOS_QUALITY_OIDC_CLIENT_ID=dataos-control-plane-quality
DATAOS_QUALITY_OIDC_CLIENT_SECRET=replace-with-client-secret
DATAOS_QUALITY_OIDC_AUDIENCE=dataos-quality-runner
DATAOS_QUALITY_OIDC_SCOPES=quality:submit quality:read
DATAOS_QUALITY_POLL_INTERVAL_MS=30000
DATAOS_QUALITY_SLA_SCAN_INTERVAL_MS=60000
DATAOS_QUALITY_SUBMIT_LEASE_MS=120000
DATAOS_RUN_SUBMIT_LEASE_MS=120000

DATAOS_NOTIFICATION_WEBHOOK_URL=https://notify.example.invalid/data-os
DATAOS_NOTIFICATION_MAX_ATTEMPTS=5
DATAOS_NOTIFICATION_LEASE_MS=120000
DATAOS_NOTIFICATION_DELIVERY_INTERVAL_MS=30000

# SeaTunnel is delivered as a separate signed offline bundle. For the local
# single-hospital overlay, set this to the imported image tag or immutable
# digest. The external overlay only needs SEATUNNEL_BASE_URL.
SEATUNNEL_IMAGE=medical-platform/data-os-seatunnel:2.3.13-dataos.2
SEATUNNEL_BASE_URL=http://seatunnel-master:8080
SEATUNNEL_JAVA_OPTS=-Xms2g -Xmx2g
# 技术域门户入口；UI URL 应填写院内技术网段或反向代理地址，不填写容器内部地址。
DATAOS_SEATUNNEL_UI_URL=
DATAOS_DOLPHINSCHEDULER_UI_URL=https://platform-tools.example.invalid/dolphinscheduler/ui/
DATAOS_RUSTFS_ENDPOINT=https://rustfs.example.invalid
DATAOS_RUSTFS_CONSOLE_URL=https://platform-tools.example.invalid/rustfs/console/

# Optional Gate 1 DolphinScheduler overlay. Use a dedicated PostgreSQL
# database/role; do not reuse DATAOS_DB_* or Keycloak credentials.
DOLPHINSCHEDULER_TAG=3.4.1
DOLPHINSCHEDULER_DB_HOST=scheduler-db.example.invalid
DOLPHINSCHEDULER_DB_PORT=5432
DOLPHINSCHEDULER_DB_NAME=dolphinscheduler
DOLPHINSCHEDULER_DB_USERNAME=dolphinscheduler_runtime
DOLPHINSCHEDULER_DB_PASSWORD=replace-with-a-long-random-password
# disable for an internal plaintext segment; use require/verify-full only with
# the hospital PostgreSQL CA and certificate policy in place.
DOLPHINSCHEDULER_DB_SSLMODE=disable
DOLPHINSCHEDULER_API_PORT=19083
DOLPHINSCHEDULER_TZ=Asia/Shanghai
DOLPHINSCHEDULER_BASE_URL=http://dolphinscheduler-api:12345/dolphinscheduler
# Bootstrap token is written once to the scheduler-token-secrets volume, then
# scheduler-token-rotator keeps current/previous tokens in that volume. Do not
# put username/password fallback credentials here.
DATAOS_DOLPHINSCHEDULER_TOKEN=
DATAOS_DOLPHINSCHEDULER_TOKEN_FILE=/run/secrets/dolphinscheduler-token.json
DATAOS_DOLPHINSCHEDULER_USERNAME=
DATAOS_DOLPHINSCHEDULER_PASSWORD=
DATAOS_DOLPHINSCHEDULER_TENANT_CODE=hospital_a_platform
DATAOS_DOLPHINSCHEDULER_SERVICE_USER=dataos_scheduler
DATAOS_DOLPHINSCHEDULER_QUEUE_ID=1
DOLPHINSCHEDULER_TOKEN_USER_ID=replace-with-dataos-scheduler-user-id
DOLPHINSCHEDULER_TOKEN_TTL_DAYS=7
DOLPHINSCHEDULER_TOKEN_ROTATE_HOURS=24
DOLPHINSCHEDULER_TOKEN_OVERLAP_MINUTES=30

# The quality runner is a standalone, allow-listed dbt runtime. It uses the
# control-plane business DB only for its queue/audit tables and reads Doris
# through a dedicated read-only account. OIDC client credentials are issued
# for audience dataos-quality-runner with quality:submit/read scopes.
DATAOS_QUALITY_RUNNER_IMAGE=medical-platform/data-os-quality-runner:0.1.0
QUALITY_RUNNER_ENV=production
QUALITY_RUNNER_AUTH_MODE=ENFORCED
QUALITY_RUNNER_OIDC_ISSUER=https://id.example.invalid/realms/data-os
QUALITY_RUNNER_OIDC_AUDIENCE=dataos-quality-runner
QUALITY_RUNNER_OIDC_REQUIRED_SCOPES=quality:submit quality:read
QUALITY_RUNNER_DB_URL=postgresql+psycopg://data_os:replace-with-db-password@postgres:5432/data_os
DORIS_FE_HOST=172.16.66.8
DORIS_FE_PORT=9030
DORIS_DATABASE=dataos_quality_acceptance
DORIS_AUDIT_DATABASE=dataos_quality_audit
DORIS_USER=dataos_quality_ro
DORIS_PASSWORD=replace-with-readonly-doris-password
# dbt only reads DORIS_DATABASE and writes failure tables in DORIS_AUDIT_DATABASE.
DORIS_DBT_USER=dataos_quality_dbt
DORIS_DBT_PASSWORD=replace-with-dbt-audit-password
DORIS_CLEANUP_USER=dataos_quality_cleanup
DORIS_CLEANUP_PASSWORD=replace-with-quality-db-cleanup-password
# RustFS endpoint; only summary JSON is written, never raw SQL or PHI.
QUALITY_RUNNER_S3_ENDPOINT=http://rustfs:9000
QUALITY_RUNNER_S3_BUCKET=dataos-quality-artifacts
QUALITY_RUNNER_S3_REGION=us-east-1
QUALITY_RUNNER_S3_ACCESS_KEY=replace-with-rustfs-access-key
QUALITY_RUNNER_S3_SECRET_KEY=replace-with-rustfs-secret-key
QUALITY_RUNNER_EVIDENCE_HASH_KEY=replace-with-a-dedicated-random-evidence-hmac-key

DATAOS_PORTAL_PORT=8080
DATAOS_PROMETHEUS_PORT=19090

# Signed responsibility notifications. Production rejects a missing secret or
# host allowlist at startup; use a secret file when possible.
DATAOS_NOTIFICATION_WEBHOOK_URL=https://notify.example.invalid/data-os
DATAOS_NOTIFICATION_WEBHOOK_SECRET=
# Host-side protected file, JSON: {"current":"<rotatable-secret>"}.
DATAOS_NOTIFICATION_WEBHOOK_SECRET_HOST_FILE=/etc/data-os/notification-webhook.json
DATAOS_NOTIFICATION_WEBHOOK_SECRET_FILE=/run/notification-secrets/webhook.secret
DATAOS_NOTIFICATION_ALLOW_HTTP=false
DATAOS_NOTIFICATION_ALLOW_PRIVATE_NETWORKS=false
DATAOS_NOTIFICATION_ALLOWED_HOSTS=notify.example.invalid
