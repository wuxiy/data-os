# OpenMetadata dbt 摄取配置（挂在 doris-dataos 服务上：质量测试 TestCase），
# 见 docs/dbt-lineage-g7-review-and-plan-20260822.md 决策 G7-1/G7-2。
#
# 由 deploy/scripts/om-dbt-ingest.sh 渲染后执行。OM 1.6.0 不需要独立服务
# 实体：sourceConfig.config.type=DBT，dbt 配置（DbtLocalConfig）随 workflow
# 提供；TestCase 挂到 serviceName 所指服务的表。产物（v12/v6，经 metadata
# 键剥离）由脚本在 quality-runner 容器生成并挂载到 /opt/dbt-artifacts
# （本模板不含口令，可安全进 Git）。catalog 未喂：DataModel 实体面为 0
# （备忘 P3）。
source:
  type: dbt
  serviceName: doris-dataos
  sourceConfig:
    config:
      type: DBT
      dbtConfigSource:
        dbtConfigType: local
        dbtManifestFilePath: /opt/dbt-artifacts/manifest.json
__DBT_RUN_RESULTS_LINE__
sink:
  type: metadata-rest
  config: {}
workflowConfig:
  openMetadataServerConfig:
    hostPort: http://openmetadata:8585/api
    # OM 1.6.0 的 WorkflowConfig schema 只收 jwtToken：custom-oidc 的
    # clientId/secretKey/tokenEndpoint 实测被 securityConfig 拒绝（extra
    # parameter，2026-09-04 探针）。令牌时效靠 Keycloak per-client
    # access.token.lifespan（dataos-om-ingest=1800s，realm 默认 300s 不动）
    # 承载——整跑约 7 分钟，300s 令牌会在 ~51% 处过期（H1 实测复现）。
    authProvider: openmetadata
    securityConfig:
      jwtToken: __OM_JWT__
